    {
      "table": "Finance Orders",
      "datasource": "Finance Orders",
      "sql": "SELECT o.order_id, o.order_date, o.sales, o.profit, o.quantity, c.region, c.segment\nFROM Orders o\nINNER JOIN Customers c ON c.customer_id = o.customer_id\nWHERE o.quantity >= <Parameters.Min Quantity>",
      "m": "let\n    Source = PostgreSQL.Database(#\"Finance Orders Server\", #\"Finance Orders Database\"),\n    Data = Value.NativeQuery(Source, \"SELECT o.order_id, o.order_date, o.sales, o.profit, o.quantity, c.region, c.segment\nFROM Orders o\nINNER JOIN Customers c ON c.customer_id = o.customer_id\nWHERE o.quantity >= \" & Text.From(#\"Min Quantity\"), null, [EnableFolding = true]),\n    Selected = Table.SelectColumns(Data, {\"order_id\", \"order_date\", \"sales\", \"profit\", \"quantity\", \"region\", \"segment\"}, MissingField.UseNull),\n    Typed = Table.TransformColumnTypes(Selected, {{\"order_id\", type text}, {\"order_date\", type date}, {\"sales\", type number}, {\"profit\", type number}, {\"quantity\", Int64.Type}, {\"region\", type text}, {\"segment\", type text}})\nin\n    Typed",
