      "pbi_object": "Fiscal Year",
      "pbi_table": "Finance Orders",
      "pbi_dax": "IF((MONTH('Finance Orders'[order_date]) >= 7), (YEAR('Finance Orders'[order_date]) + 1), YEAR('Finance Orders'[order_date]))",
