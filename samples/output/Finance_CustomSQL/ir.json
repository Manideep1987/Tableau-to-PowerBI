      "source_id": "src_finance_orders",
      "category": "column",
      "tableau": "IF DATEPART('month', [order_date]) >= 7 THEN YEAR([order_date]) + 1 ELSE YEAR([order_date]) END",
      "expression_ast": {
        "node": "If",
        "branches": [
          [
            {
              "node": "BinOp",
              "op": ">=",
              "left": {
                "node": "Func",
                "name": "DATEPART",
                "args": [
                  {
                    "node": "Str",
                    "value": "month"
                  },
                  {
                    "node": "Field",
                    "name": "order_date",
                    "datasource": null
                  }
                ]
              },
              "right": {
                "node": "Num",
                "value": 7
              }
            },
            {
              "node": "BinOp",
              "op": "+",
              "left": {
                "node": "Func",
                "name": "YEAR",
                "args": [
                  {
                    "node": "Field",
                    "name": "order_date",
                    "datasource": null
                  }
                ]
              },
              "right": {
                "node": "Num",
                "value": 1
              }
            }
          ]
        ],
        "else_": {
          "node": "Func",
          "name": "YEAR",
          "args": [
            {
              "node": "Field",
              "name": "order_date",
              "datasource": null
            }
          ]
