model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Orders", "Customers", "Products"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation ConvertedFrom = Tableau workbook Superstore_Sales

ref table _Measures
ref table Orders
ref table Customers
ref table Products
ref table 'Sales Target'
ref table 'Top N Customers'
ref table 'Discount Threshold'
ref table 'Metric Selector'
ref table Date
