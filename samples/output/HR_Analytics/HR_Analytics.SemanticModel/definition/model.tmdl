model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["employees.csv"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation ConvertedFrom = Tableau workbook HR_Analytics

ref table _Measures
ref table 'employees.csv'
ref table Date
