		sourceColumn: Performance Score

		annotation TableauSource = Performance Score

	column 'Is Active' = ISBLANK('employees.csv'[Termination Date])
		dataType: boolean
		lineageTag: 491f03c6-1aa6-5e38-ba4c-2e96bb3197e3
		summarizeBy: none

		annotation TableauSource = Calculation_H02

	column 'Tenure Years' = DIVIDE(DATEDIFF('employees.csv'[Hire Date], COALESCE('employees.csv'[Termination Date], DATE(2025, 12, 31)), DAY), 365.25)
		dataType: double
		lineageTag: e6e477e1-d296-5924-992f-868e98cc80aa
		summarizeBy: none

		annotation TableauSource = Calculation_H04

	column 'Tenure Band' = ```
		SWITCH(TRUE(),
		        ('employees.csv'[Tenure Years] < 2), "0-2 yrs",
		        ('employees.csv'[Tenure Years] < 5), "2-5 yrs",
		        "5+ yrs"
		    )
		```
		dataType: string
		lineageTag: 0f7ee621-d94a-5fc2-b9b3-73faf79075da
		summarizeBy: none

		annotation TableauSource = Calculation_H05

	column 'Dept Avg Salary' = (VAR __lod1 = 'employees.csv'[Department] RETURN CALCULATE(AVERAGE('employees.csv'[Salary]), REMOVEFILTERS(), 'employees.csv'[Department] = __lod1))
		dataType: double
		lineageTag: 27cd4bb9-6b3a-5481-bcf2-4b0795f349c7
		summarizeBy: none

		annotation TableauSource = Calculation_H06

	column 'High Performer' = IF(ISBLANK('employees.csv'[Performance Score]), BLANK(), ('employees.csv'[Performance Score] >= 4))
		dataType: boolean
		lineageTag: 3296f30e-f5dd-5860-bac4-8a1414a642c1
		summarizeBy: none

		annotation TableauSource = Calculation_H08

	column 'Hire Year' = YEAR('employees.csv'[Hire Date])
		dataType: int64
		lineageTag: fda70f71-9659-59d8-b6b7-344b34ac2f0a
		summarizeBy: none

		annotation TableauSource = Calculation_H09

	partition 'employees.csv' = m
		mode: import
		source =
				let
				    Source = File.Contents(#"Employees File"),
				    Csv = Csv.Document(Source, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Data = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Data, {"employee_id", "employee_name", "department", "job_level", "gender", "location", "hire_date", "termination_date", "salary", "performance_score"}, MissingField.UseNull),
				    Renamed = Table.RenameColumns(Selected, {{"employee_id", "Employee ID"}, {"employee_name", "Employee Name"}, {"department", "Department"}, {"job_level", "Job Level"}, {"gender", "Gender"}, {"location", "Location"}, {"hire_date", "Hire Date"}, {"termination_date", "Termination Date"}, {"salary", "Salary"}, {"performance_score", "Performance Score"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Employee ID", type text}, {"Employee Name", type text}, {"Department", type text}, {"Job Level", type text}, {"Gender", type text}, {"Location", type text}, {"Hire Date", type date}, {"Termination Date", type date}, {"Salary", type number}, {"Performance Score", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
