                      ]
                    }
                  },
                  {
                    "node": "Num",
                    "value": 1
                  }
                ]
              ],
              "else_": {
                "node": "Num",
                "value": 0
              }
            }
          ]
        },
        "right": {
          "node": "Func",
          "name": "COUNTD",
          "args": [
            {
              "node": "Field",
              "name": "Employee ID",
              "datasource": null
            }
          ]
        }
      },
      "deps": [
        "f_employees_csv_termination_date",
        "f_employees_csv_employee_id"
      ],
      "xml_path": "/workbook/datasources/datasource/column[3]",
      "pbi_object": "Attrition Rate",
      "pbi_table": "_Measures",
      "pbi_dax": "DIVIDE(SUMX('employees.csv', IF(NOT(ISBLANK('employees.csv'[Termination Date])), 1, 0)), DISTINCTCOUNTNOBLANK('employees.csv'[Employee ID]))",
