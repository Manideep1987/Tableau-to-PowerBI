      "source_id": "src_employees",
      "category": "measure",
      "tableau": "SUM(IF NOT ISNULL([Termination Date]) THEN 1 ELSE 0 END) / COUNTD([Employee ID])",
      "expression_ast": {
        "node": "BinOp",
        "op": "/",
        "left": {
          "node": "Func",
