	column 'Invoice Date Month Start' = DATE(YEAR('FactInvoices'[Invoice Date]), MONTH('FactInvoices'[Invoice Date]), 1)
		dataType: dateTime
		displayFolder: Date parts
		lineageTag: c7140803-9517-5955-83a7-13354f7b7fd1
		summarizeBy: none

		annotation TableauSource = tmn:Invoice Date

	column 'Days Late' = DATEDIFF('FactInvoices'[Due Date], 'FactInvoices'[Payment Date], DAY)
		dataType: int64
		lineageTag: 895c3694-8f27-5c96-84ae-86d3699c5743
		summarizeBy: none

		annotation TableauSource = Calculation_I05

	column 'Payment Status' = ```
		SWITCH(TRUE(),
		        ISBLANK('FactInvoices'[Payment Date]), "Unpaid",
		        IF(ISBLANK('FactInvoices'[Payment Date]), BLANK(), ('FactInvoices'[Payment Date] <= 'FactInvoices'[Due Date])), "On time",
		        "Late"
		    )
		```
		dataType: string
		lineageTag: c4c99e9b-9d78-5742-9d9b-a62a18548196
		summarizeBy: none

		annotation TableauSource = Calculation_I06

	column 'Aging Bucket' = ```
		SWITCH(TRUE(),
		        ISBLANK('FactInvoices'[Payment Date]), "Unpaid",
		        IF(ISBLANK('FactInvoices'[Days Late]), BLANK(), ('FactInvoices'[Days Late] <= 0)), "Not late",
		        IF(ISBLANK('FactInvoices'[Days Late]), BLANK(), ('FactInvoices'[Days Late] <= 15)), "1-15 days",
		        IF(ISBLANK('FactInvoices'[Days Late]), BLANK(), ('FactInvoices'[Days Late] <= 30)), "16-30 days",
		        "30+ days"
		    )
		```
		dataType: string
		lineageTag: 3400c581-59bd-58b3-b482-79b48228da97
		summarizeBy: none

		annotation TableauSource = Calculation_I07

	column 'Vendor Fixed Amount' = (VAR __lod1 = RELATED('DimVendor'[Vendor Name]) RETURN CALCULATE(SUM('FactInvoices'[Invoice Amount]), REMOVEFILTERS(), 'DimVendor'[Vendor Name] = __lod1))
		dataType: double
		lineageTag: f85f12e2-50a5-5e38-a4f3-72e8d123573b
		summarizeBy: none

		annotation TableauSource = Calculation_I08

