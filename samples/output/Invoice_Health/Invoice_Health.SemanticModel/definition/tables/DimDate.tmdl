	partition DimDate = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"Invoice Health Server", #"Invoice Health Database"),
				    Data = Source{[Schema = "dbo", Item = "DimDate"]}[Data],
				    Selected = Table.SelectColumns(Data, {"date_key", "date", "month", "fiscal_period"}, MissingField.UseNull),
				    Renamed = Table.RenameColumns(Selected, {{"date_key", "Date Key"}, {"date", "Calendar Date"}, {"month", "Month"}, {"fiscal_period", "Fiscal Period"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Date Key", Int64.Type}, {"Calendar Date", type date}, {"Month", type text}, {"Fiscal Period", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
