    {
      "id": "c_payment_status",
      "name": "Payment Status",
      "internal_name": "Calculation_I06",
      "source_id": "src_invoice_health",
      "category": "column",
      "tableau": "IF ISNULL([Payment Date]) THEN 'Unpaid' ELSEIF [Payment Date] <= [Due Date] THEN 'On time' ELSE 'Late' END",
      "expression_ast": {
        "node": "If",
        "branches": [
          [
            {
              "node": "Func",
              "name": "ISNULL",
              "args": [
                {
                  "node": "Field",
                  "name": "Payment Date",
                  "datasource": null
                }
              ]
            },
            {
              "node": "Str",
              "value": "Unpaid"
            }
          ],
          [
            {
              "node": "BinOp",
              "op": "<=",
              "left": {
                "node": "Field",
                "name": "Payment Date",
                "datasource": null
              },
              "right": {
                "node": "Field",
                "name": "Due Date",
                "datasource": null
              }
            },
            {
              "node": "Str",
              "value": "On time"
            }
          ]
        ],
        "else_": {
          "node": "Str",
          "value": "Late"
        }
      },
      "deps": [
        "f_factinvoices_payment_date",
        "f_factinvoices_due_date"
      ],
      "xml_path": "/workbook/datasources/datasource[2]/column[8]",
      "pbi_object": "Payment Status",
      "pbi_table": "FactInvoices",
      "pbi_dax": "SWITCH(TRUE(),\n        ISBLANK('FactInvoices'[Payment Date]), \"Unpaid\",\n        IF(ISBLANK('FactInvoices'[Payment Date]), BLANK(), ('FactInvoices'[Payment Date] <= 'FactInvoices'[Due Date])), \"On time\",\n        \"Late\"\n    )",
      "strategy": "rule:row-level-calculated-column",
      "confidence": "high",
      "status": "Converted",
      "classification": "PASS",
      "warnings": [],
      "overridden": false
    },
    {
      "id": "c_aging_bucket",
      "name": "Aging Bucket",
      "internal_name": "Calculation_I07",
      "source_id": "src_invoice_health",
      "category": "column",
      "tableau": "IF ISNULL([Payment Date]) THEN 'Unpaid' ELSEIF [Days Late] <= 0 THEN 'Not late' ELSEIF [Days Late] <= 15 THEN '1-15 days' ELSEIF [Days Late] <= 30 THEN '16-30 days' ELSE '30+ days' END",
      "expression_ast": {
        "node": "If",
        "branches": [
          [
            {
              "node": "Func",
              "name": "ISNULL",
              "args": [
                {
                  "node": "Field",
                  "name": "Payment Date",
                  "datasource": null
                }
              ]
            },
            {
              "node": "Str",
              "value": "Unpaid"
            }
          ],
          [
            {
              "node": "BinOp",
              "op": "<=",
              "left": {
                "node": "Field",
                "name": "Days Late",
                "datasource": null
              },
              "right": {
                "node": "Num",
                "value": 0
              }
            },
            {
              "node": "Str",
              "value": "Not late"
            }
          ],
          [
            {
              "node": "BinOp",
              "op": "<=",
              "left": {
                "node": "Field",
                "name": "Days Late",
                "datasource": null
              },
              "right": {
                "node": "Num",
                "value": 15
              }
            },
            {
              "node": "Str",
              "value": "1-15 days"
            }
          ],
          [
            {
              "node": "BinOp",
              "op": "<=",
              "left": {
                "node": "Field",
                "name": "Days Late",
                "datasource": null
              },
              "right": {
                "node": "Num",
                "value": 30
              }
            },
            {
              "node": "Str",
              "value": "16-30 days"
            }
          ]
        ],
        "else_": {
          "node": "Str",
          "value": "30+ days"
        }
      },
      "deps": [
        "f_factinvoices_payment_date",
        "c_days_late"
      ],
      "xml_path": "/workbook/datasources/datasource[2]/column[9]",
      "pbi_object": "Aging Bucket",
      "pbi_table": "FactInvoices",
      "pbi_dax": "SWITCH(TRUE(),\n        ISBLANK('FactInvoices'[Payment Date]), \"Unpaid\",\n        IF(ISBLANK('FactInvoices'[Days Late]), BLANK(), ('FactInvoices'[Days Late] <= 0)), \"Not late\",\n        IF(ISBLANK('FactInvoices'[Days Late]), BLANK(), ('FactInvoices'[Days Late] <= 15)), \"1-15 days\",\n        IF(ISBLANK('FactInvoices'[Days Late]), BLANK(), ('FactInvoices'[Days Late] <= 30)), \"16-30 days\",\n        \"30+ days\"\n    )",
