    {
      "id": "c_on_time_paid_amount",
      "name": "On Time Paid Amount",
      "internal_name": "Calculation_I02",
      "source_id": "src_invoice_health",
      "category": "measure",
      "tableau": "SUM(IF [Paid Flag] = TRUE AND [Payment Date] <= [Due Date] THEN [Invoice Amount] ELSE 0 END)",
      "expression_ast": {
        "node": "Func",
        "name": "SUM",
        "args": [
          {
            "node": "If",
            "branches": [
              [
                {
                  "node": "BinOp",
                  "op": "AND",
                  "left": {
                    "node": "BinOp",
                    "op": "=",
                    "left": {
                      "node": "Field",
                      "name": "Paid Flag",
                      "datasource": null
                    },
                    "right": {
                      "node": "Bool",
                      "value": true
                    }
                  },
                  "right": {
                    "node": "BinOp",
                    "op": "<=",
                    "left": {
                      "node": "Field",
                      "name": "Payment Date",
                      "datasource": null
                    },
                    "right": {
                      "node": "Field",
                      "name": "Due Date",
                      "datasource": null
                    }
                  }
                },
                {
                  "node": "Field",
                  "name": "Invoice Amount",
                  "datasource": null
                }
              ]
            ],
            "else_": {
              "node": "Num",
              "value": 0
            }
          }
        ]
      },
      "deps": [
        "f_factinvoices_paid_flag",
        "f_factinvoices_payment_date",
        "f_factinvoices_due_date",
        "f_factinvoices_invoice_amount"
      ],
      "xml_path": "/workbook/datasources/datasource[2]/column[4]",
      "pbi_object": "On Time Paid Amount",
      "pbi_table": "_Measures",
      "pbi_dax": "SUMX('FactInvoices', IF((('FactInvoices'[Paid Flag] = TRUE()) && IF(ISBLANK('FactInvoices'[Payment Date]), BLANK(), ('FactInvoices'[Payment Date] <= 'FactInvoices'[Due Date]))), 'FactInvoices'[Invoice Amount], 0))",
      "strategy": "rule:aggregate-measure",
      "confidence": "high",
      "status": "Converted",
      "classification": "PASS",
      "warnings": [],
      "overridden": false
    },
