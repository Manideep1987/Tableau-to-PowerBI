    <dashboards>
      <dashboard name='Executive Overview'>
        <size maxheight='800' maxwidth='1400' minheight='800' minwidth='1400' />
        <zones>
          <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
            <zone id='2' x='0' y='0' w='100000' h='8000' type-v2='text'><formatted-text><run>Executive Sales Overview</run></formatted-text></zone>
            <zone id='3' x='0' y='8000' w='100000' h='16000' name='KPI Summary'></zone>
            <zone id='4' x='0' y='24000' w='50000' h='38000' name='Sales by Region'></zone>
            <zone id='5' x='50000' y='24000' w='50000' h='38000' name='Monthly Trend'></zone>
            <zone id='6' x='0' y='62000' w='50000' h='38000' name='Category Profitability'></zone>
            <zone id='7' x='50000' y='62000' w='34000' h='38000' name='Sales Share'></zone>
            <zone id='8' x='84000' y='62000' w='16000' h='19000' name='Sales by Region' type-v2='filter' param='[federated.1x2k9wq0ab3k7l1e8cm4h0qz5lzt].[none:Segment:nk]' mode='checkdropdown'></zone>
            <zone id='9' x='84000' y='81000' w='16000' h='19000' type-v2='paramctrl' param='[Parameters].[Parameter 1]' mode='slider'></zone>
          </zone>
        </zones>
      </dashboard>
      <dashboard name='Customer Insights'>
        <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' />
        <zones>
          <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
            <zone id='2' x='0' y='0' w='60000' h='50000' name='Top Customers'></zone>
            <zone id='3' x='60000' y='0' w='40000' h='50000' name='Customer Tiers'></zone>
            <zone id='4' x='0' y='50000' w='60000' h='50000' name='Profit vs Sales'></zone>
            <zone id='5' x='60000' y='50000' w='40000' h='50000' name='State Map'></zone>
            <zone id='6' x='0' y='0' w='0' h='0' name='logo.png' type-v2='bitmap'></zone>
          </zone>
        </zones>
      </dashboard>
    </dashboards>
    <actions>
      <action caption='Filter by Region' name='[Action1]'>
        <activation auto-clear='true' type='on-select' />
        <source dashboard='Executive Overview' type='sheet' worksheet='Sales by Region' />
        <command command='tsc:tsl-filter'><param name='special-fields' value='all' /><param name='target' value='Executive Overview' /></command>
      </action>
      <action caption='Highlight Category' name='[Action2]'>
        <activation type='on-hover' />
        <source dashboard='Executive Overview' type='sheet' worksheet='Category Profitability' />
        <command command='tsc:brush'><param name='field-captions' value='Category' /></command>
      </action>
      <action caption='Open CRM' name='[Action3]'>
        <activation type='on-menu' />
        <source dashboard='Customer Insights' type='sheet' worksheet='Top Customers' />
        <command command='tsc:browser'><param name='url' value='https://crm.example.com/customer/&lt;Customer Name&gt;' /></command>
      </action>
    </actions>
</workbook>
