      <aliases enabled='yes' />
      <column datatype='string' name='[Region]' role='dimension' type='nominal'></column><column datatype='string' name='[State]' role='dimension' type='nominal' semantic-role='[State].[Name]'></column><column datatype='real' name='[Sales]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0.00'></column><column datatype='real' name='[Profit]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0.00'></column><column datatype='real' name='[Discount]' role='measure' type='quantitative' default-format='p0%'><desc><formatted-text><run>Discount rate applied to the order line</run></formatted-text></desc></column><column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' hidden='true'></column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0001]' role='measure' type='quantitative' default-format='p0.0%'><calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' /></column><column caption='Profit Status' datatype='string' name='[Calculation_0002]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &#x27;Profitable&#x27;
ELSEIF [Profit] = 0 THEN &#x27;Break-even&#x27;
ELSE &#x27;Loss&#x27;
END' /></column><column caption='Discount Band' datatype='string' name='[Calculation_0003]' role='dimension' type='nominal'><calculation class='tableau' formula='IIF(ZN([Discount]) &gt;= [Parameters].[Parameter 3], &#x27;High Discount&#x27;, &#x27;Standard&#x27;)' /></column><column caption='Days to Ship' datatype='integer' name='[Calculation_0004]' role='measure' type='quantitative'><calculation class='tableau' formula='DATEDIFF(&#x27;day&#x27;, [Order Date], [Ship Date])' /></column><column caption='Customer Lifetime Sales' datatype='real' name='[Calculation_0005]' role='measure' type='quantitative'><calculation class='tableau' formula='{FIXED [Customer Name] : SUM([Sales])}' /></column><column caption='Region Sales' datatype='real' name='[Calculation_0006]' role='measure' type='quantitative'><calculation class='tableau' formula='{ FIXED [Region] : SUM([Sales]) }' /></column><column caption='Sales vs Target' datatype='real' name='[Calculation_0007]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM([Sales]) - [Parameters].[Parameter 1]' /></column><column caption='Running Sales' datatype='real' name='[Calculation_0008]' role='measure' type='quantitative'><calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))' /></column><column caption='Sales Rank' datatype='integer' name='[Calculation_0009]' role='measure' type='quantitative'><calculation class='tableau' formula='RANK(SUM([Sales]))' /></column><column caption='Order Count' datatype='integer' name='[Calculation_0010]' role='measure' type='quantitative'><calculation class='tableau' formula='COUNTD([Order ID])' /></column><column caption='Avg Sales per Customer' datatype='real' name='[Calculation_0011]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Sales]) / COUNTD([Customer Name])' /></column><column caption='Selected Metric' datatype='real' name='[Calculation_0012]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[Parameter 4]
WHEN &#x27;Sales&#x27; THEN SUM([Sales])
WHEN &#x27;Profit&#x27; THEN SUM([Profit])
ELSE SUM([Quantity])
END' /></column><column caption='Net Sales' datatype='real' name='[Calculation_0013]' role='measure' type='quantitative'><calculation class='tableau' formula='[Sales] * (1 - [Discount])' /></column><column caption='Customer Tier' datatype='string' name='[Calculation_0014]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [Customer Lifetime Sales] &gt;= 25000 THEN &#x27;Platinum&#x27; ELSEIF [Customer Lifetime Sales] &gt;= 12000 THEN &#x27;Gold&#x27; ELSE &#x27;Silver&#x27; END' /></column><column caption='Order Month Name' datatype='string' name='[Calculation_0015]' role='dimension' type='nominal'><calculation class='tableau' formula='DATENAME(&#x27;month&#x27;, [Order Date])' /></column><column caption='Product Code' datatype='string' name='[Calculation_0016]' role='dimension' type='nominal'><calculation class='tableau' formula='UPPER(LEFT([Sub-Category], 3)) + &#x27;-&#x27; + RIGHT([Product ID], 4)' /></column><column caption='Avg Customer Sales (INCLUDE)' datatype='real' name='[Calculation_0017]' role='measure' type='quantitative'><calculation class='tableau' formula='{INCLUDE [Customer Name] : SUM([Sales])}' /></column><column caption='Share of Region' datatype='real' name='[Calculation_0018]' role='measure' type='quantitative' default-format='p1'><calculation class='tableau' formula='SUM([Sales]) / SUM([Region Sales])' /></column><column caption='Large Order' datatype='boolean' name='[Calculation_0019]' role='dimension' type='nominal'><calculation class='tableau' formula='[Quantity] &gt;= 7 AND [Sales] &gt; 500' /></column><column caption='Percent of Total Sales' datatype='real' name='[Calculation_0020]' role='measure' type='quantitative' default-format='p1'><calculation class='tableau' formula='SUM([Sales]) / TOTAL(SUM([Sales]))' /></column><column caption='Ship Quarter Start' datatype='date' name='[Calculation_0021]' role='dimension' type='ordinal'><calculation class='tableau' formula='DATETRUNC(&#x27;quarter&#x27;, [Ship Date])' /></column><column caption='Profit per Unit' datatype='real' name='[Calculation_0022]' role='measure' type='quantitative'><calculation class='tableau' formula='ZN(SUM([Profit])) / SUM([Quantity])' /></column>
      
      <column caption='Region Group' datatype='string' name='[Region (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Region]' new-bin='true'>
          <bin default-name='false' value='&quot;Coastal&quot;'><value>&quot;East&quot;</value><value>&quot;West&quot;</value></bin>
          <bin default-name='false' value='&quot;Inland&quot;'><value>&quot;Central&quot;</value><value>&quot;South&quot;</value></bin>
        </calculation>
      </column>
      <column caption='Sales (bin)' datatype='integer' name='[Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[Sales]' peg='0' size='500' />
      </column>
      <group caption='Key States' name='[Key States]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[State]' member='&quot;California&quot;' />
          <groupfilter function='member' level='[State]' member='&quot;New York&quot;' />
          <groupfilter function='member' level='[State]' member='&quot;Texas&quot;' />
        </groupfilter>
      </group>
      <group caption='Top 20 Customers' name='[Top Customers]' name-style='unqualified' user:ui-builder='filter-group'>
        <groupfilter count='20' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
          <groupfilter direction='DESC' expression='SUM([Sales])' function='order' user:ui-marker='order'>
            <groupfilter function='level-members' level='[Customer Name]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </groupfilter>
        </groupfilter>
      </group>
      <drill-paths>
        <drill-path name='Geography'><field>[Region]</field><field>[State]</field></drill-path>
        <drill-path name='Product Hierarchy'><field>[Category]</field><field>[Sub-Category]</field><field>[Product Name]</field></drill-path>
      </drill-paths>
      <folder name='KPIs' role='measures'>
        <folder-item name='[Calculation_0001]' type='field' />
        <folder-item name='[Calculation_0010]' type='field' />
      </folder>
      <_.fcp.ObjectModelTableType.true...column caption='Orders' datatype='table' name='[__tableau_internal_object_id__].[Orders_A1]' role='measure' type='quantitative' />
