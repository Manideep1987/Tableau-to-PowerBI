        <relationships><relationship><expression op='='><expression op='[Vendor Key]' /><expression op='[Vendor Key (DimVendor)]' /></expression><first-end-point object-id='FI_obj' /><second-end-point object-id='DV_obj' /></relationship><relationship><expression op='='><expression op='[Employee Key]' /><expression op='[Employee Key (DimEmployeeSecurity)]' /></expression><first-end-point object-id='FI_obj' /><second-end-point object-id='DE_obj' /></relationship><relationship><expression op='='><expression op='[Date Key]' /><expression op='[Date Key (DimDate)]' /></expression><first-end-point object-id='FI_obj' /><second-end-point object-id='DD_obj' /></relationship></relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
