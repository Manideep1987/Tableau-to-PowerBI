      <column datatype='real' name='[Invoice Amount]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0.00'>
        <desc><formatted-text><run>Invoice value in reporting currency</run></formatted-text></desc>
      </column>
      <column datatype='string' name='[Email UPN]' role='dimension' type='nominal' hidden='true' />
      <column caption='Total Invoice Amount' datatype='real' name='[Calculation_I01]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM([Invoice Amount])' /></column><column caption='On Time Paid Amount' datatype='real' name='[Calculation_I02]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IF [Paid Flag] = TRUE AND [Payment Date] &lt;= [Due Date]
THEN [Invoice Amount] ELSE 0 END)' /></column><column caption='Paid Amount' datatype='real' name='[Calculation_I03]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IF [Paid Flag] THEN [Invoice Amount] END)' /></column><column caption='On-time %' datatype='real' name='[Calculation_I04]' role='measure' type='quantitative' default-format='p0.0%'><calculation class='tableau' formula='[On Time Paid Amount] / [Paid Amount]' /></column><column caption='Days Late' datatype='integer' name='[Calculation_I05]' role='measure' type='quantitative'><calculation class='tableau' formula='DATEDIFF(&#x27;day&#x27;, [Due Date], [Payment Date])' /></column><column caption='Payment Status' datatype='string' name='[Calculation_I06]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([Payment Date]) THEN &#x27;Unpaid&#x27;
ELSEIF [Payment Date] &lt;= [Due Date] THEN &#x27;On time&#x27;
ELSE &#x27;Late&#x27;
END' /></column><column caption='Aging Bucket' datatype='string' name='[Calculation_I07]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([Payment Date]) THEN &#x27;Unpaid&#x27; ELSEIF [Days Late] &lt;= 0 THEN &#x27;Not late&#x27; ELSEIF [Days Late] &lt;= 15 THEN &#x27;1-15 days&#x27; ELSEIF [Days Late] &lt;= 30 THEN &#x27;16-30 days&#x27; ELSE &#x27;30+ days&#x27; END' /></column><column caption='Vendor Fixed Amount' datatype='real' name='[Calculation_I08]' role='measure' type='quantitative'><calculation class='tableau' formula='{ FIXED [Vendor Name] : SUM([Invoice Amount]) }' /></column><column caption='Overdue Invoices' datatype='integer' name='[Calculation_I09]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IF ISNULL([Payment Date]) AND [Due Date] &lt; #2025-12-31# THEN 1 ELSE 0 END)' /></column><column caption='Invoice Count' datatype='integer' name='[Calculation_I10]' role='measure' type='quantitative'><calculation class='tableau' formula='COUNTD([Invoice ID])' /></column><column caption='Avg Days to Pay' datatype='real' name='[Calculation_I11]' role='measure' type='quantitative'><calculation class='tableau' formula='AVG(DATEDIFF(&#x27;day&#x27;, [Invoice Date], [Payment Date]))' /></column><column caption='Selected Metric Amount' datatype='real' name='[Calculation_I12]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0'><calculation class='tableau' formula='CASE [Parameters].[Status Selector]
WHEN &#x27;Late invoices&#x27; THEN SUM(IF [Payment Status] = &#x27;Late&#x27; THEN [Invoice Amount] END)
WHEN &#x27;On time&#x27; THEN [On Time Paid Amount]
ELSE SUM([Invoice Amount])
END' /></column><column caption='Manager Security' datatype='boolean' name='[Calculation_I13]' role='dimension' type='nominal'><calculation class='tableau' formula='[Manager UPN] = USERNAME()' /></column><column caption='Vendor Share of Region' datatype='real' name='[Calculation_I14]' role='measure' type='quantitative' default-format='p1'><calculation class='tableau' formula='SUM([Invoice Amount]) / TOTAL(SUM([Invoice Amount]))' /></column>
      <drill-paths><drill-path name='Vendor Hierarchy'><field>[Region]</field><field>[Vendor Category]</field><field>[Vendor Name]</field></drill-path></drill-paths>
      <filter class='categorical' column='[federated.0inv4health9p2p].[none:Calculation_I13:nk]'>
        <groupfilter function='member' level='[none:Calculation_I13:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
