    <dashboards>
      <dashboard name='Invoice Payment Health'>
        <size maxheight='800' maxwidth='1400' minheight='800' minwidth='1400' />
        <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
