<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2024.2.0 (20242.24.0716.1944)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <column caption='Min Quantity' datatype='integer' name='[Min Quantity]' param-domain-type='range' role='measure' type='quantitative' value='2'>
        <calculation class='tableau' formula='2' />
        <range granularity='1' max='9' min='1' />
      </column>
      <column caption='Growth Rate' datatype='real' name='[Growth Rate]' param-domain-type='any' role='measure' type='quantitative' value='0.08'>
        <calculation class='tableau' formula='0.08' />
      </column>
    </datasource>
    <datasource caption='Finance Orders' inline='true' name='federated.0fin7qz2x1lb9e0a8m3k' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='pg-finance' name='postgres.1abc'>
            <connection authentication='username-password' class='postgres' dbname='finance' port='5432' server='pg-finance.corp.local' username='fin_reader' sslmode='require' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[region]' />
              <expression op='[Targets].[region]' />
            </expression>
          </clause>
          <relation connection='postgres.1abc' name='Custom SQL Query' type='text'>SELECT o.order_id, o.order_date, o.sales, o.profit, o.quantity, c.region, c.segment
FROM Orders o
INNER JOIN Customers c ON c.customer_id = o.customer_id
WHERE o.quantity &gt;= &lt;Parameters.Min Quantity&gt;</relation>
          <relation connection='postgres.1abc' name='Targets' table='[public].[Targets]' type='table' />
        </relation>
        <metadata-records><metadata-record class='column'><remote-name>order_id</remote-name><remote-type>129</remote-type><local-name>[order_id]</local-name><parent-name>[Custom SQL Query]</parent-name><remote-alias>order_id</remote-alias><local-type>string</local-type><aggregation>Count</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>order_date</remote-name><remote-type>7</remote-type><local-name>[order_date]</local-name><parent-name>[Custom SQL Query]</parent-name><remote-alias>order_date</remote-alias><local-type>date</local-type><aggregation>Year</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>sales</remote-name><remote-type>5</remote-type><local-name>[sales]</local-name><parent-name>[Custom SQL Query]</parent-name><remote-alias>sales</remote-alias><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>profit</remote-name><remote-type>5</remote-type><local-name>[profit]</local-name><parent-name>[Custom SQL Query]</parent-name><remote-alias>profit</remote-alias><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>quantity</remote-name><remote-type>20</remote-type><local-name>[quantity]</local-name><parent-name>[Custom SQL Query]</parent-name><remote-alias>quantity</remote-alias><local-type>integer</local-type><aggregation>Sum</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>region</remote-name><remote-type>129</remote-type><local-name>[region]</local-name><parent-name>[Custom SQL Query]</parent-name><remote-alias>region</remote-alias><local-type>string</local-type><aggregation>Count</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>segment</remote-name><remote-type>129</remote-type><local-name>[segment]</local-name><parent-name>[Custom SQL Query]</parent-name><remote-alias>segment</remote-alias><local-type>string</local-type><aggregation>Count</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>region</remote-name><remote-type>129</remote-type><local-name>[region (Targets)]</local-name><parent-name>[Targets]</parent-name><remote-alias>region</remote-alias><local-type>string</local-type><aggregation>Count</aggregation><contains-null>false</contains-null></metadata-record><metadata-record class='column'><remote-name>sales_target</remote-name><remote-type>5</remote-type><local-name>[sales_target]</local-name><parent-name>[Targets]</parent-name><remote-alias>sales_target</remote-alias><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>false</contains-null></metadata-record></metadata-records>
      </connection>
      <column caption='Target Attainment' datatype='real' name='[Calculation_F01]' role='measure' type='quantitative' default-format='p0.0%'><calculation class='tableau' formula='SUM([sales]) / SUM([sales_target])' /></column><column caption='Projected Sales' datatype='real' name='[Calculation_F02]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([sales]) * (1 + [Parameters].[Growth Rate])' /></column><column caption='Margin %' datatype='real' name='[Calculation_F03]' role='measure' type='quantitative' default-format='p1'><calculation class='tableau' formula='IF SUM([sales]) = 0 THEN NULL ELSE SUM([profit]) / SUM([sales]) END' /></column><column caption='Fiscal Year' datatype='integer' name='[Calculation_F04]' role='dimension' type='ordinal'><calculation class='tableau' formula='IF DATEPART(&#x27;month&#x27;, [order_date]) &gt;= 7 THEN YEAR([order_date]) + 1 ELSE YEAR([order_date]) END' /></column><column caption='Sales YoY Prior' datatype='real' name='[Calculation_F05]' role='measure' type='quantitative'><calculation class='tableau' formula='LOOKUP(SUM([sales]), -1)' /></column><column caption='Order Size' datatype='string' name='[Calculation_F06]' role='dimension' type='nominal'><calculation class='tableau' formula='CASE [quantity] WHEN 1 THEN &#x27;Single&#x27; WHEN 2 THEN &#x27;Pair&#x27; ELSE &#x27;Bulk&#x27; END' /></column><column caption='Loss Orders' datatype='integer' name='[Calculation_F07]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IF [profit] &lt; 0 THEN 1 ELSE 0 END)' /></column><column caption='Region Code' datatype='string' name='[Calculation_F08]' role='dimension' type='nominal'><calculation class='tableau' formula='UPPER(LEFT([region], 1)) + STR(LEN([region]))' /></column><column caption='Avg Monthly Sales' datatype='real' name='[Calculation_F09]' role='measure' type='quantitative'><calculation class='tableau' formula='WINDOW_AVG(SUM([sales]))' /></column><column caption='Max Order Value' datatype='real' name='[Calculation_F10]' role='measure' type='quantitative'><calculation class='tableau' formula='MAX([sales])' /></column>
      <extract count='-1' enabled='true' units='records'><connection class='hyper' dbname='Data/Extracts/finance.hyper' /></extract>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Attainment by Region'>
      
      <table>
        <view>
          <datasources><datasource caption='Finance Orders' name='federated.0fin7qz2x1lb9e0a8m3k' /></datasources>
          <datasource-dependencies datasource='federated.0fin7qz2x1lb9e0a8m3k'></datasource-dependencies>
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F01:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.0fin7qz2x1lb9e0a8m3k].[none:region:nk]</rows>
        <cols>([federated.0fin7qz2x1lb9e0a8m3k].[sum:sales:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[sum:sales_target:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F01:qk])</cols>
      </table>
    </worksheet>
    <worksheet name='Fiscal Year Sales'>
      
      <table>
        <view>
          <datasources><datasource caption='Finance Orders' name='federated.0fin7qz2x1lb9e0a8m3k' /></datasources>
          <datasource-dependencies datasource='federated.0fin7qz2x1lb9e0a8m3k'><column-instance column='[Calculation_F05]' derivation='User' name='[usr:Calculation_F05:qk]' pivot='key' type='quantitative'><table-calc ordering-type='Columns' /></column-instance></datasource-dependencies>
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.0fin7qz2x1lb9e0a8m3k].[sum:sales:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.0fin7qz2x1lb9e0a8m3k].[none:Calculation_F04:ok]</rows>
        <cols>([federated.0fin7qz2x1lb9e0a8m3k].[sum:sales:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F02:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F05:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F09:qk])</cols>
      </table>
    </worksheet>
    <worksheet name='Order Size Mix'>
      
      <table>
        <view>
          <datasources><datasource caption='Finance Orders' name='federated.0fin7qz2x1lb9e0a8m3k' /></datasources>
          <datasource-dependencies datasource='federated.0fin7qz2x1lb9e0a8m3k'></datasource-dependencies>
          <filter class='categorical' column='[federated.0fin7qz2x1lb9e0a8m3k].[none:segment:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:segment:nk]' member='&quot;Consumer&quot;' /><groupfilter function='member' level='[none:segment:nk]' member='&quot;Corporate&quot;' /></groupfilter></filter>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.0fin7qz2x1lb9e0a8m3k].[cnt:order_id:qk]' /></encodings>
          </pane>
        </panes>
        <rows>([federated.0fin7qz2x1lb9e0a8m3k].[none:Calculation_F06:nk] / [federated.0fin7qz2x1lb9e0a8m3k].[none:segment:nk])</rows>
        <cols>([federated.0fin7qz2x1lb9e0a8m3k].[cnt:order_id:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F03:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F07:qk] + [federated.0fin7qz2x1lb9e0a8m3k].[usr:Calculation_F10:qk])</cols>
      </table>
    </worksheet>
    <worksheet name='Region Codes'>
      
      <table>
        <view>
          <datasources><datasource caption='Finance Orders' name='federated.0fin7qz2x1lb9e0a8m3k' /></datasources>
          <datasource-dependencies datasource='federated.0fin7qz2x1lb9e0a8m3k'></datasource-dependencies>
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings></encodings>
          </pane>
        </panes>
        <rows>[federated.0fin7qz2x1lb9e0a8m3k].[none:Calculation_F08:nk]</rows>
        <cols>[federated.0fin7qz2x1lb9e0a8m3k].[sum:profit:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
    <dashboards>
      <dashboard name='Finance Summary'>
        <size maxheight='720' maxwidth='1280' minheight='720' minwidth='1280' />
        <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone id='2' x='0' y='0' w='50000' h='50000' name='Attainment by Region'></zone>
          <zone id='3' x='50000' y='0' w='50000' h='50000' name='Fiscal Year Sales'></zone>
          <zone id='4' x='0' y='50000' w='100000' h='50000' name='Order Size Mix'></zone>
        </zone></zones>
      </dashboard>
    </dashboards>
</workbook>
